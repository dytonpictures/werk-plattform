# WERK local development template. This file is intentionally not runnable.
# Replace every CHANGE_ME value, then restrict the copied .env to mode 0600.
WERK_ENV=development
WERK_BUILD_VERSION=dev
WERK_HTTP_ADDRESS=127.0.0.1:3000
WERK_HTTP_TLS_MODE=disabled
WERK_ALLOWED_ORIGINS=http://127.0.0.1:3000

WERK_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
WERK_DEV_WORKER_PASSWORD=CHANGE_ME
WERK_IDENTITY_MFA_ENABLED=true
WERK_IDENTITY_ADMIN_MFA_REQUIRED=false
WERK_IDENTITY_WORK_SESSION_TTL=12h
WERK_IDENTITY_ADMIN_SESSION_TTL=8h
WERK_IDENTITY_WORK_SESSION_IDLE_TTL=30m
WERK_IDENTITY_ADMIN_SESSION_IDLE_TTL=15m
WERK_IDENTITY_MFA_KEYS=current:CHANGE_ME
WERK_IDENTITY_MFA_CURRENT_KEY_ID=current
WEBAUTHN_RP_ID=127.0.0.1
WEBAUTHN_RP_NAME=WERK
WEBAUTHN_ORIGINS=http://127.0.0.1:3000

WERK_WORKER_CONCURRENCY=4
WERK_KAFKA_ENABLED=false
# Kafka uses three mandatory, distinct security and retention spaces when enabled.
WERK_KAFKA_BROKERS=127.0.0.1:59092
WERK_KAFKA_DOMAIN_EVENTS_TOPIC=platform.domain-events.v1
WERK_KAFKA_SECURITY_AUDIT_TOPIC=platform.security-audit.v1
WERK_KAFKA_RUNTIME_LOGS_TOPIC=platform.runtime-logs.v1
WERK_KAFKA_CLIENT_ID=platform-development
WERK_KAFKA_PUBLISH_TIMEOUT_SECONDS=10
WERK_KAFKA_AUDIT_CONCURRENCY=1
# Production additionally requires TLS plus SASL or a client certificate.
# WERK_KAFKA_TLS=true
# WERK_KAFKA_TLS_CA_FILE=/etc/werk/kafka-ca.pem
# WERK_KAFKA_TLS_SERVER_NAME=kafka.internal
# WERK_KAFKA_SASL_MECHANISM=scram-sha-512
# WERK_KAFKA_SASL_USERNAME=werk
# WERK_KAFKA_SASL_PASSWORD=CHANGE_ME
# Optional replaceable cache adapter; use rediss:// or valkeys:// in production.
# WERK_CACHE_URL=valkey://127.0.0.1:6379/0

# The five process boundaries deliberately use separate PostgreSQL roles.
WORK_DATABASE_URL=postgresql://werk_work_runtime:CHANGE_ME@127.0.0.1:5432/werk?sslmode=disable
IDENTITY_DATABASE_URL=postgresql://werk_identity_runtime:CHANGE_ME@127.0.0.1:5432/werk?sslmode=disable
ADMIN_DATABASE_URL=postgresql://werk_admin_runtime:CHANGE_ME@127.0.0.1:5432/werk?sslmode=disable
WORKER_DATABASE_URL=postgresql://werk_worker_runtime:CHANGE_ME@127.0.0.1:5432/werk?sslmode=disable
MIGRATOR_DATABASE_URL=postgresql://werk_migrator:CHANGE_ME@127.0.0.1:5432/werk?sslmode=disable
